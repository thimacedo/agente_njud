# Configurações do Pipeline DIVISOR
# Copie este arquivo para .env e ajuste os valores conforme necessário

# Caminhos de diretórios
BOLETINS_BRUTOS=./boletins_brutos
BOLETINS_CORTADOS=./boletins_cortados
JORNAIS_MONTADOS=./jornais_montados
DRIVE_SYNC=./drive_sync
LOGS_DIR=./logs

# Parâmetros de qualidade de áudio
DURACAO_MINIMA_BOLETIM=2.0
DURACAO_MINIMA_JORNAL=60.0
TAMANHO_MINIMO_ARQUIVO=102400
LIMIAR_SILENCIO=-50.0

# Parâmetros de retry
MAX_RETRIES=3
RETRY_DELAY=1.0
RETRY_BACKOFF=2.0

# Configurações de NJUD
BOLETINS_POR_JORNAL=4
INTERCALAR_VOCES=true
BLOCO_INTERCALACAO=5

# Metadados
VERSAO_PIPELINE=1.1.0
PROJETO_NOME=DIVISOR
