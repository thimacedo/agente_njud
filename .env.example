# =============================================================================
# CONFIGURAÇÕES DO PIPELINE DIVISOR
# =============================================================================
# Copie este arquivo para .env e ajuste os valores conforme seu ambiente.
# Nunca commitar o arquivo .env real no Git (já está no .gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# CAMINHOS DE DIRETÓRIOS
# -----------------------------------------------------------------------------
# Diretório base do projeto (padrão: F:/Projetos/DIVISOR)
BASE_DIR=F:/Projetos/DIVISOR

# Pasta de entrada dos boletins brutos (MP3 originais)
BOLETINS_BRUTOS=${BASE_DIR}/boletins_brutos

# Pasta onde ficam os cortes (CABECA/CORPO) após divisão
BOLETINS_CORTADOS=${BASE_DIR}/data/processed/JORNAIS_DIVIDIDOS

# Pasta de saída dos jornais montados (NJUDs finais)
DIR_OUTPUT=${BASE_DIR}/data/output

# Subpasta dentro de DIR_OUTPUT onde ficam os jornais finais
JORNAIS_MONTADOS=${DIR_OUTPUT}/JORNAIS_FINAL

# Caminho do Google Drive para sincronização (Windows)
DRIVE_SYNC=H:\Meu Drive\RADIO TJRN CONTEÚDO\00_PRODUCAO_2026\02_JORNAIS_NJUD\03_AUDIOS_RADIO

# Alias para o caminho do Drive (usado pelo settings.py)
DIR_DRIVE_JORNAIS=${DRIVE_SYNC}

# Pasta de logs do pipeline
LOGS_DIR=${BASE_DIR}/logs

# -----------------------------------------------------------------------------
# PARÂMETROS DE QUALIDADE DE ÁUDIO
# -----------------------------------------------------------------------------
# Duração mínima aceitável para um boletim (segundos)
DURACAO_MINIMA_BOLETIM=2.0

# Duração mínima aceitável para um jornal completo (segundos)
DURACAO_MINIMA_JORNAL=60.0

# Tamanho mínimo de arquivo em bytes (100KB = 102400)
TAMANHO_MINIMO_ARQUIVO=102400

# Limiar de silêncio para detecção de vinhetas (dB)
LIMIAR_SILENCIO=-50.0

# -----------------------------------------------------------------------------
# PARÂMETROS DE RETRY E RESILIÊNCIA
# -----------------------------------------------------------------------------
# Número máximo de tentativas para operações falhas
MAX_RETRIES=3

# Delay inicial entre retries (segundos)
RETRY_DELAY=1.0

# Fator de backoff exponencial (delay multiplica por este valor a cada retry)
RETRY_BACKOFF=2.0

# -----------------------------------------------------------------------------
# CONFIGURAÇÕES DE NJUD (JORNAL)
# -----------------------------------------------------------------------------
# Quantidade de boletins que formam um jornal (padrão: 4)
BOLETINS_POR_JORNAL=4

# Ativar intercalação de vozes diferentes no mesmo jornal (true/false)
INTERCALAR_VOCES=true

# Tamanho do bloco para intercalação (ex: 5 significa que a cada 5 boletins
# alterna entre locutores A e B)
BLOCO_INTERCALACAO=5

# -----------------------------------------------------------------------------
# METADADOS E VERSIONAMENTO
# -----------------------------------------------------------------------------
# Versão atual do pipeline (usada para logging e metadados)
VERSAO_PIPELINE=1.1.0

# Nome do projeto (usado em logs e identificadores)
PROJETO_NOME=DIVISOR

# -----------------------------------------------------------------------------
# EXEMPLOS DE USO PARA DIFERENTES AMBIENTES
# -----------------------------------------------------------------------------
# Ambiente de teste (Linux/Mac):
# BASE_DIR=/home/usuario/projetos/DIVISOR
# DRIVE_SYNC=/mnt/google_drive/RADIO_TJRN
#
# Ambiente de homologação (outra máquina Windows):
# BASE_DIR=D:/Projetos/DIVISOR
# DRIVE_SYNC=G:/Meu Drive/RADIO TJRN CONTEÚDO/PRODUCAO
#
# CI/CD ou testes automatizados:
# BASE_DIR=/tmp/divisor_test
# BOLETINS_BRUTOS=${BASE_DIR}/test_fixtures/boletins
# LOGS_DIR=${BASE_DIR}/test_logs
